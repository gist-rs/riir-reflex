# riir-reflex local configuration — the template for `.env`.
#
# Copy:  cp .env.example .env   then fill in real values.
# `.env` is gitignored — NEVER commit it, never paste its values anywhere else.
#
# Nothing in this repo sources `.env` automatically: export what you need in
# the shell (`set -a; . ./.env; set +a`) before running `reflex`, the harness,
# or a lane script. Every variable here is OPTIONAL — the engine boots with
# none of them; each one switches on a lane, a credential, or an override.

# ── Cloudflare tokens (present in local .env — NOT read by this repo's code) ─
# CF_API_TOKEN / CF_DEPLOY_API_TOKEN: no file in src/, scripts/, tests/ or
#   .github/ reads either name. They sit in the local .env for MANUAL
#   wrangler work (the reflex-site deploy runs from the sibling repo).
#   Probed 2026-10-03 (.plans/011): neither carries Workers AI scope, so they
#   CANNOT serve the Clef lane below — that needs its own token.
#   Get (deploy): CF dashboard → My Profile → API Tokens → Create Token →
#   Custom → `Account · Workers Scripts · Edit`.
#   ⚠ Alias hazard: wrangler honours CF_API_TOKEN as a DEPRECATED ALIAS of
#   CLOUDFLARE_API_TOKEN — if both are exported, a wrongly-scoped value
#   silently breaks wrangler auth. Run wrangler as
#   `env -u CLOUDFLARE_API_TOKEN -u CF_API_TOKEN CLOUDFLARE_API_TOKEN="$CF_DEPLOY_API_TOKEN" npx wrangler deploy`.
# CF_API_TOKEN=
# CF_DEPLOY_API_TOKEN=

# ── Clef lane — Cloudflare Workers AI (src/lanes/clef.rs, plan 011) ─────────
# CLEF_API_TOKEN: bearer attached to Workers AI `ai/run` calls (a local
#   forwarder may inject it instead). Absent → no Authorization header; a
#   direct Workers AI call then fails 401.
#   Get: CF dashboard → My Profile → API Tokens → Create Token → Custom →
#   `Account · Workers AI · Read` + `Edit` (run). Minimal scope only.
# CLEF_ACCOUNT_ID: CF account id used to build the default run path.
#   Get: CF dashboard → Workers & Pages → right sidebar "Account ID".
#   Not needed when CLEF_RUN_PATH is set.
# CLEF_API_TOKEN=
# CLEF_ACCOUNT_ID=
# CLEF_RUN_PATH=                      full run-path override (skips the account id)
# CLEF_SERVE_URL=http://127.0.0.1:8791
# CLEF_MODEL=clef                     clef | clef-flash
# CLEF_TIMEOUT_MS=120000
# CLEF_SMOKE_MAX_CASES=50             spend ceiling per suite (pricing undisclosed)
# CLEF_ALLOW_UNCAPPED=1               explicit override of that ceiling
# CLEF_LOCAL=1                        local in-process ANE arm (feature clef-ane, macOS)

# ── Comparison lanes: optional bearer tokens for third-party servers ───────
# Each is attached only when set; absent = unauthenticated (loopback default).
# Issued by whoever runs that server — there is no public dashboard.
# PPLX_API_KEY: bearer for the pplx lane server (their AUTOJEV_API_KEY).
# D3_API_KEY:   bearer for the d3 lane server (their DECISION_API_KEY).
# PAW_API_KEY:  programasweights.com API key (the SDK's own name).
#   Absent = anonymous posture. Get: from your programasweights.com account
#   (exact page unverified).
# PPLX_API_KEY=
# D3_API_KEY=
# PAW_API_KEY=

# ── Comparison lanes: server URLs / devices (all optional, defaults shown) ─
# PPLX_SERVE_URL=http://127.0.0.1:8793      PPLX_TIMEOUT_MS=300000   PPLX_DEVICE=
# D3_SERVE_URL=http://127.0.0.1:8794        D3_TIMEOUT_MS=300000     D3_DEVICE=
# D1_SERVE_URL=http://127.0.0.1:8078
# DREX_SERVE_URL=http://127.0.0.1:8000
# OPENTHAI_SERVE_URL=http://127.0.0.1:8000
# CLM_SERVE_URL=http://127.0.0.1:8700
# JEVA_SERVE_URL=http://127.0.0.1:8095
# AGENTJEV_SERVE_URL=http://127.0.0.1:8149  AGENTJEV_DEVICE=
# PAW_API_URL=https://programasweights.com
# PAW_COMPILER=  PAW_COMPILE_ASYNC=  PAW_SPECS_DIR=  PAW_PROGRAM_CACHE=  PAW_CURL=
# PAW_LOCAL_PYTHON=  PAW_LOCAL_SCRIPT=      (src/lanes/paw_local.rs)

# ── `reflex` serve (src/serve.rs) ───────────────────────────────────────────
# RIIR_REFLEX_BIND: listen address. Default loopback.
# RIIR_REFLEX_BIND=127.0.0.1:7331
# RIIR_REFLEX_ALLOWED_ORIGIN: comma-separated CORS allow-list
#   (e.g. https://reflex.gist.rs). Default EMPTY = no cross-origin access.
# RIIR_REFLEX_ALLOWED_ORIGIN=
# RIIR_REFLEX_CORPUS: boot corpus dir. Absent = the demo engine; a named
#   corpus that fails to load EXITS (no silent demo fallback).
# RIIR_REFLEX_CORPUS=
# RIIR_REFLEX_HEADS_DIR / RIIR_REFLEX_HEADS_PUBKEY: game-heads vessel dir and
#   the 64-hex ed25519 verifying key that pins it (printed by `reflexer sign`
#   in riir-reflexer). Compiled pins come first; the env key is the fallback.
# RIIR_REFLEX_HEADS_DIR=
# RIIR_REFLEX_HEADS_PUBKEY=
# RIIR_REFLEX_LAYA=1          enable the laya comparison lane over HTTP (1/true/yes)
# RIIR_REFLEX_LAYA_ANE=1      route that lane to the ANE arm
# RIIR_REFLEX_ANE_BASE_URL=   ANE arm base URL override
# RIIR_REFLEX_SYSTEMONE_SPACED=1  spaced JSON rendering (presence-only switch)

# ── Signing / encrypted corpus store ────────────────────────────────────────
# REFLEXER_SIGN_KEY: 64-hex ed25519 seed for `reflex` vessel signing
#   (src/bin/reflex.rs). Precedence: --key > --key-file > this env.
#   Absent and no flag → refuses (fail-closed). Generate:
#   `openssl genpkey -algorithm ed25519` (OpenSSL 3; see riir-reflexer
#   scripts/vmint-keygen.sh for the seed-extraction recipe).
# REFLEXER_SIGN_KEY=
# NDB_PASSPHRASE: passphrase inherited by the neuron-db child process
#   (src/harness/corpus_db.rs). Set → the corpus store is encrypted; absent →
#   plaintext posture (explicit ack flag passed). Generate: `openssl rand -hex 32`.
# NDB_BIN: path to the neuron-db CLI binary (default: resolved beside the store).
# NDB_PASSPHRASE=
# NDB_BIN=

# ── Laya model / harness locations ─────────────────────────────────────────
# LAYA_WEIGHTS_DIR / LAYA_HOME / LAYA_PY_WEIGHTS: laya weights location
#   (default: the HF cache ~/.cache/huggingface/hub/models--convaiinnovations--laya).
# LAYA_ANE_ARTIFACTS_DIR: ANE artifact root (default assets/ane).
# LAYA_PYTHON / LAYA_PYTHON_LANE_SCRIPT / LAYA_PY_DEVICE / LAYA_DEVICE:
#   python-oracle lane interpreter, script and device overrides.
# REFLEX_BENCH_HOST: descriptive host label for bench rows (e.g. 4090-windows);
#   the bench-site merge keys rows by host and refuses a generic hostname.
# LAYA_WEIGHTS_DIR=
# LAYA_ANE_ARTIFACTS_DIR=assets/ane
# REFLEX_BENCH_HOST=

# ── Script / bench / debug knobs (not runtime config) ──────────────────────
# Python lane servers: JEVA_BIND JEVA_PORT JEVA_MODEL JEVA_DEVICE JEVA_DTYPE
#   JEVA_CACHE JEVA_ALLOW_NULL (scripts/jeva_server.py); BEKKO_MODEL
#   BEKKO_REVISION BEKKO_DEVICE; GLINER_MODEL GLINER_PY_DEVICE; CUA_S1_*;
#   PAW_LOCAL_N_CTX; PAW_CACHE; OPENTHAI_PORT; PORT_CLM PORT_VLLM GPU_UTIL
#   (scripts/clm_serve_4090.sh); CLM_SRC; JEVMEM_DIR REFLEX_SERVE_URL
#   TYPESAFE_BASE_URL (jevmem scripts).
# Bench/gate scripts: MAX_LOAD SETTLE_MIN CANARY_BIN CANARY_REF_US CANARY_RUNS
#   CANARY_TOL_PCT (bench_preflight.sh); PAIRED_AB_REBUILD PAIRED_AB_NO_PREFLIGHT;
#   MAX_ATTEMPTS MAX_WAIT_H POLL_S; FORCE OUT SLEEP SUITES TRAIN_CAP
#   (fetch_datasets.sh); CHECK (fetch_artifacts.sh).
# Tests/examples/debug: JDI_REQUIRE_DATA REFLEX_SEAT_REQUIRE_DATA
#   SLICE_LEAK_REQUIRE_DATA LAYA_HARNESS_NO_WARMUP LAYA_METAL_PROFILE
#   LAYA_SPLIT_* LAYA_GEMM_FORCE LAYA_CUDA_REG4 SGEMM_M* RIDGE_DUMP
#   RIIR_DEBUG_RIDGE RIIR_DEBUG_CAL_RANK RIIR_DEBUG_CAL_WINDOW RIIR_REFLEX_G1_DIAG.
