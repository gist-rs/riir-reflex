/target
Cargo.lock.bak
.benchmarks/data/
/dist
/.raw/

# Local credentials (owner-provided CF tokens, plan 011 Phase A6) — never committed
.env

# ANE artifacts (Plan 002 P0): the .mlpackage binaries stay LOCAL ONLY (3.0 GB
# for the six; download-on-demand + digest-pinned is the ruled release scope,
# issue 017). The committed record is assets/ane/manifest.json + conversion_log.md.
assets/ane/**/*.mlpackage/
assets/ane/**/*.mlmodelc/
assets/ane/**/*.mlmodel
# Issue 037: the e8 table sidecars — same artifact rule (the multilingual one
# is 197.6 MB, over the git host's 100 MB per-file limit); manifest + log carry
# the digests.
assets/ane/**/table_e8.safetensors

# Local release staging (separate git repos pushed to their own remotes) + packaged artifacts
dist/

# Agent-instructions symlink (CLAUDE.md -> AGENTS.md), local only
CLAUDE.md

# Wrangler local state (cache/tmp — never repo content)
.wrangler/

# Throwaway verification shots (the documented scratch spot, AGENTS.md)
scripts/out/

# cargo-refine machine-local state (trajectories, fixseq, outbox, active-set)
.refine/

# The artifact directory law (Plan 623 T5): everything under artifacts/
# is untracked EXCEPT the one manifest — the repo's ONLY tracked file
# there and the ONE index the boundary gate adjudicates.
artifacts/**
!artifacts/manifest.toml

