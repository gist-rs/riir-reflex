+/// PROBE (Issue 020 follow-up, not for commit): per-kernel serialized wall.
+pub static KTIME: Mutex<Vec<(&'static str, u64, u64)>> = Mutex::new(Vec::new());
+fn ktime_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var("LAYA_KTIME").as_deref() == Ok("1"))
+}
+pub static KFLASH: Mutex<Vec<u64>> = Mutex::new(Vec::new());
+fn ktime_add(name: &'static str, ns: u64) {
+    if name == "flash_attn" {
+        KFLASH.lock().unwrap().push(ns);
+    }
+    let mut v = KTIME.lock().unwrap();
+    match v.iter_mut().find(|e| e.0 == name) {
+        Some(e) => { e.1 += ns; e.2 += 1; }
+        None => v.push((name, ns, 1)),
+    }
+}
